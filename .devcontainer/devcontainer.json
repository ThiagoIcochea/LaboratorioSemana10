{
  "name": "Laboratorio Monitoreo Cloud UTP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [8000, 9090, 3000],
  "portsAttributes": {
    "8000": { "label": "App catalogo" },
    "9090": { "label": "Prometheus" },
    "3000": { "label": "Grafana", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install --user requests && bash scripts/validar_entorno.sh || true",
  "customizations": {
    "vscode": { "extensions": ["ms-azuretools.vscode-docker", "redhat.vscode-yaml"] }
  }
}
