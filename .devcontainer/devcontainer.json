{
  "name": "Laboratorio Monitoreo Cloud UTP",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "forwardPorts": [8000, 9090, 3000],
  "portsAttributes": {
    "8000": { "label": "App catalogo" },
    "9090": { "label": "Prometheus" },
    "3000": { "label": "Grafana", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install --user requests || true",
  "customizations": {
    "vscode": { "extensions": ["ms-azuretools.vscode-docker", "redhat.vscode-yaml"] }
  }
}
